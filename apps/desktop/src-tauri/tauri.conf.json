{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "mukuchi",
  "version": "0.1.2",
  "identifier": "com.minimalcorp.mukuchi",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "resources": {
      "../THIRD_PARTY_NOTICES": "THIRD_PARTY_NOTICES",
      "resources/silero/LICENSE": "licenses/silero-vad-LICENSE",
      "bundle-resources/asr-server": "asr-server",
      "bundle-resources/verify.wav": "verify.wav"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "hardenedRuntime": true,
      "entitlements": "Entitlements.plist",
      "files": {
        "Helpers/uv": "bundle-resources/bin/uv"
      }
    }
  }
}
